{% import "macros.html.j2" as m %}
<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
<meta name="generator" content="LLM Forensics {{ meta.tool_version }}">
<title>{{ title }}</title>
<style>
{% include "styles.css.j2" %}
</style>
</head>
<body>
<main class="report">
    <header class="report-header">
        <div class="brand">LLM Forensics report</div>
        <h1>{{ title }}</h1>
        <p class="subtitle">
            <span class="tag">{{ meta.analysis or "unknown" }}</span>
            created <span class="mono">{{ meta.created|human_date }}</span>
            · tool version <span class="mono">{{ meta.tool_version }}</span>
        </p>
    </header>

    {% block preamble %}
    <section class="panel">
        <div class="panel-header"><h3>Sources</h3></div>
        <div class="panel-body">
            {% if meta.inputs %}{{ m.source_lines(meta.inputs) }}{% else %}<p class="text-muted">None recorded.</p>{% endif %}
        </div>
    </section>

    <section class="panel">
        <div class="panel-header"><h3>Parameters</h3></div>
        <div class="panel-body">
            {% if meta.parameters %}{{ m.kv_table_pair(meta.parameters) }}{% else %}<p class="text-muted">None recorded.</p>{% endif %}
        </div>
    </section>

    {{ m.message_panel("Warnings", meta.warnings, "warning") }}
    {% endblock %}

    {% block content %}{% endblock %}

    <footer class="report-footer">
        Generated by LLM Forensics {{ meta.tool_version }} · static report, the full data is in report.json
    </footer>
</main>
</body>
</html>
